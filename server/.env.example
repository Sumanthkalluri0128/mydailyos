MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://flexfit.vercel.app
NODE_ENV=production
# Optional: report server errors to Sentry (requires the optional @sentry/node package)
SENTRY_DSN=

# ---------------------------------------------------------------- Password-reset emails
# Render's FREE tier blocks outbound SMTP (ports 25/465/587) and has no IPv6, so Gmail/SMTP cannot work there
# (that is the "connect ENETUNREACH ...:465" error). Use an HTTPS email API instead — easiest is Brevo:
#   1) brevo.com -> free account -> SMTP & API -> API Keys -> create key
#   2) Senders -> add + verify the address you want mail to come from (your Gmail is fine)
# Best free option: send from your own Gmail via the Gmail API (run scripts/gmail-token.js once — see SETUP_V5.md)
GMAIL_REFRESH_TOKEN=
# Brevo cannot authenticate gmail.com senders (mail may land in spam) — use it with your own domain
BREVO_API_KEY=
# or: RESEND_API_KEY=   (needs a verified domain to email anyone other than yourself)
MAIL_FROM=FlexFit <your-verified-sender@gmail.com>
# Only for paid hosts that allow SMTP. Without any provider, dev prints the code to the log.
SMTP_URL=

# ---------------------------------------------------------------- Google (Sign in + "FlexFit data" Google Sheet)
# console.cloud.google.com -> new project -> enable "Google Sheets API"
# -> OAuth consent screen (External; add yourself as a test user) -> Credentials -> OAuth client ID -> "Web application"
# -> Authorized redirect URI:  https://<your-api>.onrender.com/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only if the callback URL can't be derived from the request host
GOOGLE_REDIRECT_URI=
# Optional: separate key for encrypting stored Google refresh tokens (defaults to JWT_SECRET)
GOOGLE_TOKEN_KEY=
# Set to false to skip filling the shared food catalogue (127 everyday foods) on startup
SEED_FOODS=true
