MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://flexfit.vercel.app
NODE_ENV=production
# Optional: report server errors to Sentry (requires the optional @sentry/node package)
SENTRY_DSN=

# Password reset emails (the reset code is sent here). Without it, dev mode prints the code to the server log
# and production silently skips sending. Example: smtps://user:pass@smtp.example.com
SMTP_URL=
MAIL_FROM=FlexFit <no-reply@yourdomain.com>
# Set to false to skip filling the shared food catalogue (127 everyday foods) on startup
SEED_FOODS=true
